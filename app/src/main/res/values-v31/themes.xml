<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RanesVision" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- Post-splash window background -->
        <item name="android:windowBackground">@android:color/black</item>
        
        <!-- Splash Screen API Configuration -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
